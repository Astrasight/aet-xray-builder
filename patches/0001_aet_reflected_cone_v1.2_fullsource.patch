+
+void CRender::AetUpdateLensProbe()
+{
+	m_aetLensProbeValid = false;
+
+	float bestSSA = -1.f;
+	for (R_dsgraph::mapScopeHUD_T_Node* node = mapScopeHUDSorted.begin(); node != mapScopeHUDSorted.end(); ++node)
+	{
+		if (!node->val.pVisual || node->val.ssa < bestSSA)
+			continue;
+
+		Fvector worldCenter;
+		node->val.Matrix.transform_tiny(worldCenter, node->val.pVisual->getVisData().sphere.P);
+		if (!_valid(worldCenter))
+			continue;
+
+		Fvector forward = node->val.Matrix.k;
+		Fvector up = node->val.Matrix.j;
+		if (forward.square_magnitude() < EPS_S || up.square_magnitude() < EPS_S)
+			continue;
+		forward.normalize();
+		up.normalize();
+
+		// HUD model conventions are not perfectly uniform across addons. Pick the
+		// signs that face roughly the same way as the player's main view, then
+		// orthogonalize the lens up-axis so weapon roll is preserved in capture.
+		if (forward.dotproduct(Device.vCameraDirection) < 0.f)
+			forward.mul(-1.f);
+		if (up.dotproduct(Device.vCameraTop) < 0.f)
+			up.mul(-1.f);
+		up.mad(up, forward, -up.dotproduct(forward));
+		if (up.square_magnitude() < EPS_S)
+			continue;
+		up.normalize();
+
+		bestSSA = node->val.ssa;
+		m_aetLensProbePosition.set(worldCenter);
+		m_aetLensProbeForward.set(forward);
+		m_aetLensProbeUp.set(up);
+		m_aetLensProbeValid = true;
+	}
+}
+
+void CRender::AetRenderCaptureLocalLights()
+{
+	if (!ps_r_aet_lens_reflect_local_lights || m_aetCaptureLights.empty())
+		return;
+
+	// No OCCQ and no secondary shadow maps: the lens is tiny on screen, so a
+	// shadowless local-light approximation is both stable and materially better
+	// than the sun-only v1.1 capture. Original light flags are restored per draw.
+	for (light* L : m_aetCaptureLights)
+	{
+		if (!L || !L->flags.bActive || L->flags.bStatic || L->get_hud_mode())
+			continue;
+
+		if (L->flags.type != IRender_Light::POINT && L->flags.type != IRender_Light::SPOT)
+			continue;
+
+		const bool savedShadow = !!L->flags.bShadow;
+		const bool savedVolumetric = !!L->flags.bVolumetric;
+		L->flags.bShadow = FALSE;
+		L->flags.bVolumetric = FALSE;
+
+		if (L->flags.type == IRender_Light::POINT)
+		{
+			Target->accum_point(L);
+		}
+		else
+		{
+			LR.compute_xf_spot(L);
+			Target->accum_spot(L);
+		}
+
+		L->flags.bShadow = savedShadow;
+		L->flags.bVolumetric = savedVolumetric;
+	}
+}

+void CRender::AetTryCaptureReflection()
+{
+	if (!ps_r_aet_lens_reflect)
+	{
+		g_aet_refl_cam1.w = 0.0f;
+		return;
+	}
+
+	if (!scope_3D_fake_enabled || !m_aetLensVisibleThisFrame)
+		return;
+
+	// First functional build deliberately matches the user's current runtime:
+	// no MSAA, SDR. Do not silently run an unverified resource-copy path.
+	if (o.dx10_msaa || o.dx11_hdr10)
+	{
+		g_aet_refl_cam1.w = 0.0f;
+		return;
+	}
+
+	const u32 cadence = _max(1, ps_r_aet_lens_reflect_cadence);
+	if ((Device.dwFrame % cadence) != 0 || m_aetLastCaptureFrame == Device.dwFrame)
+		return;
+
+	if (!Target || !Target->rt_tempzb || !Target->rt_aet_lens_reflection ||
+		!g_pGamePersistent || !g_pGamePersistent->Environment().CurrentEnv)
+	{
+		g_aet_refl_cam1.w = 0.0f;
+		return;
+	}
+
+	// Back up the finished main depth. The secondary render reuses HW.pBaseZB.
+	ID3D11Resource* mainDepth = nullptr;
+	HW.pBaseZB->GetResource(&mainDepth);
+	if (!mainDepth)
+	{
+		g_aet_refl_cam1.w = 0.0f;
+		return;
+	}
+	HW.pContext->CopyResource(Target->rt_tempzb->pSurface, mainDepth);
+	_RELEASE(mainDepth);
+
+	SAetSavedCamera saved;
+	AetSaveCamera(saved);
+	CSector* savedSector = pLastSector;
+	Fvector savedLastCameraPos = vLastCameraPos;
+
+	m_aetReflectionCapturePass = true;
+	m_aetLastCaptureFrame = Device.dwFrame;
+	m_aetCaptureLights.clear();
+
+	// v1.2: capture from the visible 3DSS lens rather than from the actor eye.
+	// The lens shader node carries the exact HUD/world transform of the rendered
+	// objective sub-visual; its visual sphere center is a robust per-scope probe.
+	Fvector captureDir = saved.dir;
+	Fvector captureTop = saved.top;
+	if (ps_r_aet_lens_reflect_probe && m_aetLensProbeValid)
+	{
+		const float probeDistance = saved.pos.distance_to(m_aetLensProbePosition);
+		if (probeDistance < 2.0f)
+		{
+			Device.vCameraPosition.set(m_aetLensProbePosition);
+
+			// Put the virtual camera a couple of centimetres in front of the
+			// objective to avoid starting exactly inside lens/tube geometry.
+			Device.vCameraPosition.mad(m_aetLensProbePosition, m_aetLensProbeForward, 0.02f);
+
+			// Follow weapon sway only when the model axis is plausibly aligned
+			// with the real view direction; otherwise retain the main camera axis.
+			if (_abs(m_aetLensProbeForward.dotproduct(saved.dir)) > 0.70f)
+			{
+				captureDir.set(m_aetLensProbeForward);
+				captureTop.set(m_aetLensProbeUp);
+			}
+		}
+	}
+
+	AetSetReflectionCamera(captureDir, captureTop);
+
+	// Same-frame recursion must own a fresh light accumulator. Without this,
+	// phase_accumulator() sees the primary frame mark and reuses primary lighting.
+	Target->aet_force_accumulator_clear();
+
+	// Recalculate camera-dependent SSA thresholds for the wide secondary view.
+	// Sector changes are renderer-local during capture and restored afterwards.
+	Calculate();
+
+	// Recursive Render() is capture-gated. phase_combine() copies the
+	// pre-postprocess LDR scene (rt_Generic_0) to $user$aet_lens_reflection
+	// immediately after forward geometry, then returns before volumetrics,
+	// bloom, distortion, sunshafts, LUT/TAA/DOF and backbuffer work.
+	Render();
+
+	// Calculate() is allowed to detect a different sector for the objective
+	// probe, but that renderer-only sector must never leak into gameplay state.
+	pLastSector = savedSector;
+	vLastCameraPos.set(savedLastCameraPos);
+
+	m_aetReflectionCapturePass = false;
+	m_aetCaptureLights.clear();
+
+	AetRestoreCamera(saved);
+	AetRestoreMainDepth();
+
+	// Restore main-view camera-dependent globals and sun position for later UI/debug.
+	Calculate();
+
+	// Capture exits with rt_Color bound; CLevel::OnRender still draws UI afterward.
+	Target->u_setrt(Device.dwWidth, Device.dwHeight, HW.pBaseRT, NULL, NULL, HW.pBaseZB);
+	RCache.set_xform_view(Device.mView);
+	RCache.set_xform_project(Device.mProject);
 }
 
